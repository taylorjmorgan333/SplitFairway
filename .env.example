# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# --- Supabase ---
# Found in your Supabase project: Settings -> API
# Safe to expose in the browser (public, anon-key based).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it
# into any file that ships to the browser or any Server Action/route
# used by real traffic. The running app does not require it for normal
# authenticated usage — the only thing in this repo that reads it is
# scripts/seed-demo.ts (see "Demo seed" below), a local-dev-only script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL of this deployment, used to build redirect links
# (e.g. password reset emails, invitation links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED before a real production launch. The one real, monitored
# support mailbox — shown on the Contact and data-deletion pages via
# src/components/ui/support-email.tsx. Never invented or hardcoded: if
# this is unset, those pages visibly say support email isn't configured
# instead of showing a placeholder that looks real. next.config.mjs also
# logs a build-time warning when this is missing in a production build.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@splitfairwaygolf.com

# --- Email (optional) ---
# Server-only. Both are optional — set BOTH to send real reminder
# emails through Resend's REST API (see src/lib/email/provider.ts).
# Leave either unset and the app falls back to a safe development-mode
# provider that logs a full preview of the email to the server console
# instead of sending it, and never claims delivery. Reminders are still
# fully usable with no email provider configured: every reminder also
# gets copyable text-message-style text in the UI.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=SplitFairway <reminders@yourdomain.com>

# Optional. When set, the in-app "Feedback" button also emails a copy of
# every beta submission to this address via the same provider as above
# (RESEND_API_KEY/EMAIL_FROM_ADDRESS must both be set for that email to
# actually send). Feedback is always saved to the beta_feedback table
# regardless of whether this is set or an email provider is configured.
# FEEDBACK_TO_ADDRESS=beta-feedback@yourdomain.com

# --- Demo seed (local development only) ---
# Required by `npm run seed:demo` (scripts/seed-demo.ts), never read by
# the app itself. That script refuses to run at all unless this is set
# to exactly "true" AND NEXT_PUBLIC_SITE_URL above points at localhost —
# it creates 8 fake demo golfer accounts and a sample trip using
# SUPABASE_SERVICE_ROLE_KEY, and must never be pointed at a shared or
# production database. Leave unset; set it only per-invocation, e.g.:
#   ALLOW_DEMO_SEED=true npm run seed:demo
# ALLOW_DEMO_SEED=false

# --- Golf scoring feature flags (server-only) ---
# Every flag below defaults OFF (unset = disabled) and turns on only
# with the exact string "true" — same convention as ALLOW_DEMO_SEED.
# None of these are NEXT_PUBLIC_: every page that checks one is
# server-rendered, so the flag never needs to reach the browser. See
# src/lib/config.ts.
#
# Shows the "Golf Profile" section on Account settings (manual GHIN
# number/handicap entry). Everything else below builds on this.
# GOLF_SCORING_ENABLED=true
#
# Enables round-level side games (skins, Nassau, closest-to-pin, etc.)
# once round creation ships.
# SIDE_GAMES_ENABLED=true
#
# Gates dollar-value side games specifically — points-only games work
# without this. Requires the 18+ confirmation and the fixed notice text
# ("SplitFairway records privately arranged golf-game results...") to
# be shown and accepted before any monetary game can be created.
# MONETARY_GAME_VALUES_ENABLED=true
#
# Enables "Import from a GHIN screenshot" on the Golf Profile section
# (phase 3 — not implemented yet as of this flag's introduction).
# GHIN_SCREENSHOT_IMPORT_ENABLED=true
#
# Enables the Supabase Realtime-backed live leaderboard during a round.
# LIVE_LEADERBOARD_ENABLED=true

# --- Course data (optional) ---
# Server-only. NEVER prefix with NEXT_PUBLIC_. Your own GolfCourseAPI
# (https://golfcourseapi.com) API key — enables course search on
# /courses/new (src/lib/golf/golfcourseapi.ts). Without it, course
# search shows a "not set up yet" message and golfers can still add any
# course to the library by hand, exactly as before.
# GOLFCOURSEAPI_KEY=
#
# GolfCourseAPI feature flags (server-only, "true" to enable — same
# convention as the golf-scoring flags above). A flag can be true while
# GOLFCOURSEAPI_KEY is still unset (shows a controlled setup message,
# never a crash) and the key can be set while a flag is off (search
# stays server-blocked regardless). See src/lib/config.ts.
#
# Master switch for the whole GolfCourseAPI integration (usage
# dashboard, correction reporting, refresh). Leave off until a key is
# configured and you're ready to spend the free-tier daily budget.
# GOLFCOURSE_API_ENABLED=true
#
# Shows the "Search for a course" card on /courses/new. Requires
# GOLFCOURSE_API_ENABLED=true.
# GOLFCOURSE_API_SEARCH_ENABLED=true
#
# Shows the admin-only "Refresh from GolfCourseAPI" button on a
# provider-sourced course's detail page. Requires GOLFCOURSE_API_ENABLED=true.
# GOLFCOURSE_API_REFRESH_ENABLED=true
#
# Keeps the "Add a course manually" card available. Defaults ON
# (inverted convention, deliberately) — manual entry is the app's
# original course-data path and must keep working even with every
# GolfCourseAPI flag above off. Set to the exact string "false" to hide it.
# MANUAL_COURSE_ENTRY_ENABLED=false
#
# Daily GolfCourseAPI request ceiling, shared across all SplitFairway
# users on the one API key. Defaults to 50 (GolfCourseAPI's free-tier
# limit — see golfcourseapi.com/pricing) if unset.
# GOLFCOURSE_API_DAILY_REQUEST_LIMIT=50

# --- Stripe (not implemented yet) ---
# Reserved for a future release that charges for the software
# subscription itself. This app never routes golfer-to-golfer money.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
