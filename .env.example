# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# --- Supabase ---
# Found in your Supabase project: Settings -> API
# Safe to expose in the browser (public, anon-key based).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it
# into any file that ships to the browser. Used only in trusted server
# contexts (e.g. admin scripts, future server-only routes) — the app
# does not require it for standard authenticated usage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL of this deployment, used to build redirect links
# (e.g. password reset emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (not implemented yet) ---
# Reserved for a future release that charges for the software
# subscription itself. This app never routes golfer-to-golfer money.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
